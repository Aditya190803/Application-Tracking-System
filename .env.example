# Google Gemini Variables
GOOGLE_API_KEY=""
# Default is usually gemini-2.5-flash
MODEL_NAME="gemini-2.5-flash"
AI_TIMEOUT_MS="30000"
PDF_PARSE_TIMEOUT_MS="12000"
COVER_LETTER_ROUTE_TIMEOUT_MS="35000"
RESUME_ROUTE_TIMEOUT_MS="45000"
LATEX_RENDER_API_BASE="https://latexonline.cc"

# Convex Variables
NEXT_PUBLIC_CONVEX_URL=""
# Server-only: required for API routes to call internal Convex functions (from Convex dashboard → Settings → Deploy Key)
CONVEX_DEPLOY_KEY=""

# Stack Auth Variables
NEXT_PUBLIC_STACK_PROJECT_ID=""
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=""
STACK_SECRET_SERVER_KEY=""

# Optional
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Rate limiting backend (required in production unless ALLOW_IN_MEMORY_RATE_LIMIT=true)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
ALLOW_IN_MEMORY_RATE_LIMIT=""

# Axiom (optional — structured logs + ingest; stdout [obs] always works)
# Dataset name must match your Axiom dataset (e.g. ats-prod)
AXIOM_TOKEN=""
AXIOM_DATASET="ats-prod"
# US ingest edge host (from Axiom ingest URL); omit to use SDK default
AXIOM_EDGE="us-east-1.aws.edge.axiom.co"
AXIOM_SERVICE="ats"
# Set true when debugging server errors in Axiom (no resume/job text logged)
LOG_OBS_ERROR_DETAILS=""

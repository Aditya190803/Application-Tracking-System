# OpenCode Zen Variables (OpenAI-compatible API)
OPENCODE_API_KEY=""
# Optional base URL override; defaults to https://opencode.ai/zen/v1
OPENCODE_BASE_URL=""
# big-pickle is a reasoning model: reasoning tokens are charged against max_tokens,
# so keep output budgets well above ~1024 or responses come back empty.
MODEL_NAME="big-pickle"
AI_TIMEOUT_MS="30000"
PDF_PARSE_TIMEOUT_MS="12000"
COVER_LETTER_ROUTE_TIMEOUT_MS="35000"
RESUME_ROUTE_TIMEOUT_MS="45000"
LATEX_RENDER_API_BASE="https://latexonline.cc"

# Convex Variables
NEXT_PUBLIC_CONVEX_URL=""
# Server-only: required for API routes to call internal Convex functions (from Convex dashboard → Settings → Deploy Key)
CONVEX_DEPLOY_KEY=""

# Stack Auth Variables
NEXT_PUBLIC_STACK_PROJECT_ID=""
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=""
STACK_SECRET_SERVER_KEY=""

# Optional — also used as the base for "tailor my resume" links in alert emails
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional JavaScript career-page rendering fallback, using Firecrawl's scrape API.
# Example: https://firecrawl.adityamer.dev or https://api.firecrawl.dev
# Leave empty to use provider APIs and ordinary HTML only.
FIRECRAWL_API_BASE_URL=""
# Server-only; required when your rendering service enforces API authentication.
FIRECRAWL_API_KEY=""

# Job alert emails (Resend). Both are required before any alert is sent;
# without them the cron still scans and stores new listings, and mails them on
# the first run after the keys are added.
RESEND_API_KEY=""
# Must use a domain verified in Resend, e.g. "ATS Job Alerts <alerts@yourdomain.com>"
EMAIL_FROM=""

# Shared secret for /api/cron/scan-watchlist. Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>". The endpoint rejects every request
# when this is unset.
CRON_SECRET=""

# Rate limiting backend (required in production unless ALLOW_IN_MEMORY_RATE_LIMIT=true)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
ALLOW_IN_MEMORY_RATE_LIMIT=""

# Axiom (optional — structured logs + ingest; stdout [obs] always works)
# Dataset name must match your Axiom dataset (e.g. ats-prod)
AXIOM_TOKEN=""
AXIOM_DATASET="ats-prod"
# US ingest edge host (from Axiom ingest URL); omit to use SDK default
AXIOM_EDGE="us-east-1.aws.edge.axiom.co"
AXIOM_SERVICE="ats"
# Set true when debugging server errors in Axiom (no resume/job text logged)
LOG_OBS_ERROR_DETAILS=""
